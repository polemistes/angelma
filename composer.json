{
    "name": "angelma/angelma",
    "description": "A small PHP content management system for shared web hosting.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "ext-pdo_sqlite": "*",
        "league/commonmark": "^2.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Angelma\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Angelma\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true
    }
}
